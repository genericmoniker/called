[Unit]
Description=Called Application
After=network.target

[Service]
User=app-user
Group=app-user
WorkingDirectory=/home/app-user/called
EnvironmentFile=/var/opt/called/production.env
ExecStart=/home/app-user/.local/bin/uv run gunicorn --config deployment/server/gunicorn-config.py called.wsgi:application
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=called

[Install]
WantedBy=multi-user.target
