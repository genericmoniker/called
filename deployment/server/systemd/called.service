[Unit]
Description=Called Application
After=network.target

[Service]
WorkingDirectory=%h/called
EnvironmentFile=%h/.config/called/production.env
ExecStart=%h/.local/bin/uv run gunicorn --config deployment/server/gunicorn-config.py called.wsgi:application
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=called

[Install]
WantedBy=default.target
