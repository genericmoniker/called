[Unit]
Description=Called Application
After=network.target

[Service]
Type=notify
User=app-user
Group=app-user
WorkingDirectory=/home/app-user/called
ExecStart=uv run gunicorn called.wsgi:application \
    --workers 4 \
    --worker-class gthread \
    --threads 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
